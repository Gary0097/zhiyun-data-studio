{
  "id": "zhiyun-data-studio",
  "name": "企业数据分析中心",
  "version": "0.9.2",
  "type": "app",
  "description": "从 Data Core 持久化订单驱动的实时进度、交付风险、趋势、每日简报与跨部门指标分析。",
  "author": "Zhiyun AI",
  "entry": {
    "backend": "backend/main.py",
    "frontend": "ui/index.js"
  },
  "dependencies": [
    "openpyxl>=3.1,<4",
    "python-multipart>=0.0.9,<1"
  ],
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "meta": {
    "pawapp": {
      "icon": "📊",
      "category": "data",
      "entry_page": "/apps/zhiyun-data-studio",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": true,
      "storage": false
    },
    "requires": ["zhiyun-data-core>=0.1.0"]
  }
}
