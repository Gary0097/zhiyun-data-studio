{
  "id": "zhiyun-data-studio",
  "name": "Data Studio",
  "version": "0.3.0",
  "type": "app",
  "description": "统一数据导入、字段管理、模拟数据、订单进度看板、数据质量与交付风险分析。",
  "author": "Zhiyun AI",
  "entry": {
    "backend": "backend/main.py",
    "frontend": "ui/index.js"
  },
  "dependencies": [
    "openpyxl>=3.1,<4",
    "python-multipart>=0.0.9,<1"
  ],
  "qwenpaw_version": {
    "min": "2.1.0",
    "max": "2.2.0"
  },
  "meta": {
    "pawapp": {
      "icon": "📊",
      "category": "data",
      "entry_page": "/apps/zhiyun-data-studio",
      "launch_scope": "page"
    },
    "permissions": {
      "chat": true,
      "storage": false
    },
    "requires": ["zhiyun-data-core>=0.1.0"]
  }
}
